<script src="<?autov('/plugins/plexstreams/js/plex.js')?>"></script>
<script async>
    window.PS_REFRESH_MS      = <?= $refresh * 1000 ?>;
    window.PS_SHOW_POSTERS    = <?= $posters ?>;
    window.PS_ALLOW_TERMINATE = <?= $allowKill ?>;
    window.PS_SORT_MODE       = '<?= $sortMode ?>';
    $(function() {
        updateDashboardStreamsNew();
        psStartPolling();
        // Pause polling while the dashboard tab is hidden; resume + fetch
        // immediately when it comes back. Saves hits on Plex when nobody's
        // looking and gives a fresh view on focus.
        document.addEventListener('visibilitychange', function() {
            if (document.hidden) {
                psStopPolling();
            } else {
                updateDashboardStreamsNew();
                psStartPolling();
            }
        });
    });
</script>
